    "private": true,
    "scripts": {
        "build": "tsup --config tsup.config.ts && node -e \"const { copyFileSync } = require('node:fs'); copyFileSync('src/prompt/prompt.md', 'dist/prompt.md');\"",
        "test": "vitest run"
    },
    "dependencies": {
        "ignore": "^7.0.5",
        "zod": "^4.3.6",
        "ai": "^6.0.0",
        "@ai-sdk/openai-compatible": "^2.0.0",
        "@modelcontextprotocol/sdk": "^1.24.3",
        "diff": "^8.0.3",
        "minimatch": "^10.0.1"
    },
