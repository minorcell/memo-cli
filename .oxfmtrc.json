{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": false,
    "tabWidth": 4,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 120,
    "sortPackageJson": false,
    "ignorePatterns": ["node_modules", "dist", ".next", "out", "coverage", "**/pnpm-lock.yaml", "**/*.md", "**/*.mdx"]
}
